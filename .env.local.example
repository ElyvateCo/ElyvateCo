# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Elyvate <onboarding@resend.dev>
RESEND_DOMAIN=resend.dev

# 2Checkout
TWOCHECKOUT_SELLER_ID=your_seller_id
TWOCHECKOUT_SECRET_KEY=your_secret_key

# Multi-tenant routing
# Your platform's domain. "myshop.elyvateco.com" -> the store with subdomain "myshop".
# Set to: elyvateco.com (after you buy it and add *.elyvateco.com in Vercel)
# Leave empty while testing locally (use http://myshop.localhost:3000 instead).
NEXT_PUBLIC_ROOT_DOMAIN=
# Which store the bare root domain / localhost / *.vercel.app previews show
# (until the platform landing page exists). Must match a row in the stores table.
DEFAULT_STORE_SUBDOMAIN=elyvate

# App
NEXT_PUBLIC_APP_URL=https://yvate-ptln.vercel.app

# Encrypts merchants' bKash / Nagad API keys before they are saved in Supabase.
# 64 random hex characters.  Generate one:  openssl rand -hex 32
# (Keep it secret and NEVER change it later, or saved keys become unreadable.)
PAYMENT_SECRET_KEY=
