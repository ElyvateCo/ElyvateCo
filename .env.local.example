# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Elyvate <onboarding@resend.dev>
RESEND_DOMAIN=resend.dev

# 2Checkout
TWOCHECKOUT_SELLER_ID=your_seller_id
TWOCHECKOUT_SECRET_KEY=your_secret_key

# Multi-tenant routing
# Your platform's domain. "myshop.elyvate.com" -> the store with subdomain "myshop".
# Leave empty while testing locally (use http://myshop.localhost:3000 instead).
NEXT_PUBLIC_ROOT_DOMAIN=
# Which store the bare root domain / localhost / *.vercel.app previews show
# (until the platform landing page exists). Must match a row in the stores table.
DEFAULT_STORE_SUBDOMAIN=elyvate

# App
NEXT_PUBLIC_APP_URL=https://yvate-ptln.vercel.app
